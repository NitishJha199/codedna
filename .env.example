# CodeDNA environment configuration
#
# This file contains configuration placeholders only.
# Never place real credentials or secrets in this file.

# Application
APP_ENV=development
APP_NAME=codedna
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codedna
POSTGRES_USER=codedna
POSTGRES_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# API
API_HOST=0.0.0.0
API_PORT=8000
