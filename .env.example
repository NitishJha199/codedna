# CodeDNA environment configuration
#
# This file contains configuration placeholders only.
# Never place real credentials or secrets in this file.

# Application
APP_ENV=development
APP_NAME=codedna
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=codedna
POSTGRES_USER=codedna
POSTGRES_PASSWORD=change-me

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_AUTH=neo4j/change-me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# API
API_HOST=0.0.0.0
API_PORT=8000
